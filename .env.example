# Example environment for project-ophanim.
# Copy to .env.local and fill in only the keys you have:
#
#   cp .env.example .env.local
#
# The Auth.js block at the bottom is REQUIRED: the app is behind a Google
# sign-in and will let nobody in without it. Everything else here is OPTIONAL.
# With no other values set the app still runs: the no-key sources (ip-api,
# Shodan InternetDB, DNSBLs, Feodo, MetaDefender, CIRCL hashlookup, Team Cymru
# MHR, etc.) work out of the box, and the cache/history features simply stay
# disabled. .env.local wins over .env, and .env* files are gitignored, so never
# commit real keys.

# =============================================================================
# Google sign-in gate (Auth.js) — REQUIRED
# =============================================================================
# Unlike everything below, this does not degrade gracefully: the whole app is
# behind a Google sign-in limited to one Workspace domain.

# Session signing key. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth client, from Google Cloud Console > APIs & Services >
# Credentials > Create credentials > OAuth client ID > Web application.
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Trust the Host header. Vercel is detected automatically, so this is only
# needed when the app is reached on a host Auth.js cannot infer: an ngrok
# tunnel, a reverse proxy, or `next start` on a non-default port. Without it
# Auth.js refuses the request with UntrustedHost, which fails closed: the
# session never reads, so every page redirects to sign-in and sign-in itself
# cannot complete.
# AUTH_TRUST_HOST=true

# The single Google Workspace domain allowed to sign in, e.g. example.com.
# Matched against Google's "hd" claim, which Google sets only for Workspace
# accounts. Unset means nobody gets in, not everybody: a misconfigured
# allowlist fails closed on purpose.
ALLOWED_GOOGLE_HD=

# =============================================================================
# Result cache + per-indicator history (Upstash Redis, optional)
# =============================================================================
# Without these, caching and history are skipped (the app degrades gracefully).
# The URL must be the HTTPS REST endpoint (https://...upstash.io), NOT a
# rediss:// connection string, the cache rejects anything that isn't https://.
# Use either the UPSTASH_* names or the KV_* names that Vercel's Upstash
# integration injects, the cache reads whichever pair is present.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cache TTL in seconds (optional; a default applies when unset or invalid).
# TI_CACHE_TTL_SECONDS=3600

# =============================================================================
# Key-gated TI sources (each source runs only when its key is set)
# =============================================================================

# VirusTotal, multi-engine AV detection (IP, domain, hash). https://www.virustotal.com
VIRUSTOTAL_API_KEY=

# AbuseIPDB, crowdsourced IP abuse reports (IP). https://www.abuseipdb.com
ABUSEIPDB_API_KEY=

# AlienVault OTX, community threat pulses (IP, domain, hash). https://otx.alienvault.com
OTX_API_KEY=

# GreyNoise, internet background-noise / scanner classification (IP). https://www.greynoise.io
GREYNOISE_API_KEY=

# Criminal IP, IP reputation + scan data (IP). https://www.criminalip.io
CRIMINALIP_API_KEY=

# IPinfo, extra geolocation / ASN vote (IP). https://ipinfo.io
IPINFO_TOKEN=

# ipgeolocation.io, extra geolocation / ASN vote (IP). https://ipgeolocation.io
IPGEOLOCATION_API_KEY=

# Bulk geolocation tuning (optional; sane defaults apply if unset).
# Uncertain IPs per bulk request that get an RDAP allocation-country lookup.
BULK_RDAP_MAX=25
BULK_RDAP_CONCURRENCY=8
# Uncertain IPs per bulk request that get a freeipapi corroboration lookup.
BULK_GEO_FANOUT_MAX=15
BULK_GEO_FANOUT_CONCURRENCY=8

# abuse.ch Auth-Key, a single key enables ThreatFox, URLhaus, and MalwareBazaar
# (IP, domain, hash). https://auth.abuse.ch
THREATFOX_API_KEY=

# Google Safe Browsing, malicious-URL / domain lookups (domain).
# https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Hybrid Analysis, sandbox detonation verdict (hash). https://www.hybrid-analysis.com
HYBRID_ANALYSIS_API_KEY=

# Pulsedive, indicator risk + linked indicators (hash). https://pulsedive.com
PULSEDIVE_API_KEY=

# Kaspersky OpenTIP, hash reputation zone + detections (hash). https://opentip.kaspersky.com
KASPERSKY_OPENTIP_API_KEY=

# Hatching Triage, sandbox family/score + network IOCs (hash). https://tria.ge
TRIAGE_API_KEY=

# =============================================================================
# Optional keys (source already works without one; the key only raises limits)
# =============================================================================

# Maltiverse, sample classification + related indicators (hash). The /sample
# endpoint is public, so this runs keyless; a free key only raises the rate
# limit. https://maltiverse.com
MALTIVERSE_API_KEY=

# CertSpotter, certificate-transparency lookups (domain). Runs keyless; a key
# raises the unauthenticated rate limit. https://sslmate.com/certspotter
CERTSPOTTER_API_KEY=

# =============================================================================
# Present in code but NOT currently enabled
# =============================================================================
# Censys Platform host scan data. The adapter exists but is not wired into any
# registry (paid platform, intentionally excluded), so setting this has no
# effect today. Left here for reference. https://platform.censys.io
# CENSYS_API_SECRET=

# =============================================================================
# Platform / local dev tooling (optional, sensible defaults)
# =============================================================================
# Vercel auto-injects this in production for absolute OpenGraph/canonical URLs;
# you do not set it locally. https://vercel.com
# VERCEL_PROJECT_PRODUCTION_URL=

# Base URL for the scripts/ helpers (e.g. back-forward.mjs). Default below.
# BASE=http://localhost:3000

# Output directory for scripts/shot.mjs screenshots. Default below.
# SHOT_DIR=/tmp/claude/shots
