# Example environment for project-ophanim.
# Copy to .env.local and fill in only the keys you have:
#
#   cp .env.example .env.local
#
# Everything here is OPTIONAL. With no values set, the app still runs:
# the no-key sources (ip-api, Shodan InternetDB, DNSBLs, Feodo, etc.) work
# out of the box, and the cache/history features simply stay disabled.

# --- Result cache + per-indicator history (Upstash Redis, optional) ---
# Without these, caching and history are skipped (the app degrades gracefully).
# Use either the UPSTASH_* names or the KV_* names Vercel's Upstash integration
# injects — the cache reads whichever pair is present.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cache TTL in seconds (optional; defaults apply when unset/invalid).
# TI_CACHE_TTL_SECONDS=3600

# --- Key-gated TI sources (each enabled only when its key is set) ---

# VirusTotal — multi-engine AV detection (IP, domain, hash). https://www.virustotal.com
VIRUSTOTAL_API_KEY=

# AbuseIPDB — crowdsourced IP abuse reports. https://www.abuseipdb.com
ABUSEIPDB_API_KEY=

# AlienVault OTX — community threat pulses (IP, domain, hash). https://otx.alienvault.com
OTX_API_KEY=

# GreyNoise — internet background-noise / scanner classification. https://www.greynoise.io
GREYNOISE_API_KEY=

# Criminal IP — IP reputation + scan data. https://www.criminalip.io
CRIMINALIP_API_KEY=

# abuse.ch Auth-Key — a single key enables ThreatFox, URLhaus, and MalwareBazaar.
# https://auth.abuse.ch
THREATFOX_API_KEY=

# Censys Platform — host scan data (Personal Access Token, sent as Bearer).
# https://platform.censys.io
CENSYS_API_SECRET=

# Google Safe Browsing — malicious-URL/domain lookups. https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Hybrid Analysis — sandbox detonation verdict for hashes. https://www.hybrid-analysis.com
HYBRID_ANALYSIS_API_KEY=
